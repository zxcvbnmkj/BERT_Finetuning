{
  "train_batch_size": 128,
  "gradient_accumulation_steps": 4,
  "optimizer": {
    "type": "Adam",
    "params": {
      "lr": 0.00015,
      "weight_decay": 0.01,
      "eps": 1e-8
    }
  },
  "scheduler": {
    "type": "WarmupDecayLR",
    "params": {
      "warmup_min_lr": 0,
      "warmup_max_lr": 1.5e-4,
      "warmup_num_steps": 1000,
      "warmup_type": "cosine"
    }
  },
  "fp16": {
    "enabled": true,
    "loss_scale": 0,
    "loss_scale_window": 100
  },
  "zero_optimization": {
    "stage": 2,
    "contiguous_gradients": true,
    "cpu_offload": false
  },
  "gradient_clipping": 1.0
}